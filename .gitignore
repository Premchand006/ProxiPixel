/public/vendor/

# ---- TypeScript ----
*.tsbuildinfo

# ---- Testing ----
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache
/.playwright
/.lighthouseci

# ---- Environment / secrets ----
.env
.env*.local
*.pem

# ---- Scratch & local-only tooling (never committed) ----
/tmp/
/scripts/
/work-desk.png
/Gemini_Generated_Image_*.png

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Editor / OS ----
.vscode/*
!.vscode/extensions.json
.idea
*.swp
.DS_Store
Thumbs.db

# Local Netlify folder
.netlify
