# ---- Dependencies ----
/node_modules
.pnpm-store
.pnpm-debug.log*

# ---- Next.js / build output ----
/.next/
/out/
/build
next-env.d.ts

# ---- Vendored runtime assets (regenerated by `tools/vendor-assets.mjs` on
