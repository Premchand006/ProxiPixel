{
  "name": "proxipixel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "drizzle-kit migrate",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.0",
    "@supabase/supabase-js": "2.108.2",
    "docx": "9.7.1",
    "drizzle-orm": "0.38.3",
    "heic-to": "1.5.2",
    "jszip": "3.10.1",
    "mammoth": "1.12.0",
    "marked": "18.0.5",
    "next": "^15.5.19",
    "postgres": "^3.4.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "turndown": "7.2.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@types/node": "25.9.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/turndown": "5.0.6",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "drizzle-kit": "0.30.1",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.19",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "25.0.1",
    "postcss": "8.4.49",
    "prettier": "3.8.4",
    "sharp": "0.35.2",
    "tailwindcss": "3.4.17",
    "typescript": "6.0.3",
    "vitest": "2.1.9"
  }
}
