# Copy to .env.local and fill in. NEVER commit real values.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only. Bypasses RLS — must never be exposed to the browser or prefixed NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- Database (Drizzle migrations) ---
# Use the connection-pooled string for serverless runtime; direct string for migrations.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- OAuth (configure providers in Supabase Auth dashboard, not here) ---
# Google/GitHub client IDs/secrets are set in the Supabase dashboard.

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
